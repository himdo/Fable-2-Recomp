# --- Game content (ripped disc; see README "How to extract") ---------------
default.xex
/data/
/nxeart/
/$SystemUpdate/

# --- Build artifacts --------------------------------------------------------
out
generated
.pi
nul
pi-session-*.html

# --- Runtime logs written next to the exe (may land in the root when running
#     with --game_data_root) ---------------------------------------------------
fable2_func_trace.log
fable2_func_trace_prev.log
fable2_func_summary.log
fable2_func_summary_prev.log
fps_probe.log

# --- SDK / runtime artifacts ------------------------------------------------
.fable2_image.bin

# --- Local scratch (old build logs, screenshots, session exports,
#     stray runtime content folders) ------------------------------------------
/scratch/

# --- Manifest backup (pre-rename safety copy) --------------------------------
fable_2_manifest.toml.bak

# --- Helper scripts & images (kept out of the repo) ---------------------------
*.ps1
*.py
*.sh
*.png
build_*.log
rebuild.log
rebuild2.log
__pycache__/

# --- Build-critical scripts (tracked DESPITE the rules above) -----------------
# The reproducible/AV-clean build toolset (tools/repro) is invoked by CMake's
# POST_BUILD and imports across its modules; the recomp-patch and remote-control
# helpers are invoked by CMake at build time. A fresh clone must have them or the
# build fails. Everything else matching the rules above stays out of the repo.
!tools/repro/*.py
!tools/apply_recomp_patches.py
!tools/fable2_control.py

# --- Fetched/external toolchain deps (created by tools/setup_sdk*.cmd). -------
# The tracked files in thirdparty/ (rexglue-sdk-local.patch,
# rexglue-sdk-submodule-pins.txt, vulkan/, vk_video/) stay in the repo.
thirdparty/rexglue-sdk-src/
thirdparty/android-ndk/

# --- Historical reference (pre-ReXGlue XenonRecomp configs) -------------------
XenonRecomp
