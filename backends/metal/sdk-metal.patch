+template <typename T>
+XE_FORCEINLINE XE_NOALIAS static T mod_shift_left(T value, uint32_t by) {
+#if XE_ARCH_AMD64 == 1
+  // arch has modular shifts
+  return value << by;
+#else
+  return value << (by % (sizeof(T) * CHAR_BIT));
+#endif
