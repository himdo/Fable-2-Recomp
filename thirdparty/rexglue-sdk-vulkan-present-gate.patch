 Presenter::PaintResult VulkanPresenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  // Vsync present gate (see Presenter::VsyncPresentGateAllows): when the
+  // `vsync` cvar is enabled, at most one present into the swapchain is allowed
+  // per host vblank. Decide before acquiring: an acquired swapchain image only
+  // returns to the presentation engine by being presented, so skipping the
+  // present after the acquire would leak one image per suppressed paint until
+  // every acquire fails and the window stops updating.
+  if (!VsyncPresentGateAllows()) {
+    if (execute_ui_drawers) {
+      // The UI drawers that would have requested the next paint don't run
+      // this time; keep the continuous UI repaint going.
+      RequestUIPaintFromUIThread();
+    }
+    // The swapchain keeps showing the last presented image until a paint on a
+    // later vblank presents the fresh content.
+    return PaintResult::kPresented;
+  }
